# VERITY GRAPH — optional LLM extraction configuration (names only, no secrets in VCS)
# Copy to .env and fill locally; never commit a filled .env.
# If these are unset, the CLI reports an actionable error and all other modes work offline.

# Provider identifier, e.g. "openai" (the LLM extractor is an optional Phase 3 mode)
VERITY_LLM_PROVIDER=
# API key for the provider above
VERITY_LLM_API_KEY=
# Optional model identifier override
VERITY_LLM_MODEL=
