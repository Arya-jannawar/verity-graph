  TARGET_COMPILE_PDB = CMakeFiles\verity_tests.dir\
  TARGET_FILE = verity_tests.exe
  TARGET_IMPLIB = verity_tests.lib
  TARGET_PDB = verity_tests.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\verity_tests.dir


#############################################
# Utility command for test

build CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "D:\VIT\cp project\build-asan" && D:\ProgramFIles\bin\ctest.exe "
  DESC = Running tests...
  pool = console
  restat = 1

build test: phony CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "D:\VIT\cp project\build-asan" && D:\ProgramFIles\bin\cmake-gui.exe -S"D:\VIT\cp project" -B"D:\VIT\cp project\build-asan""
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "D:\VIT\cp project\build-asan" && D:\ProgramFIles\bin\cmake.exe --regenerate-during-build -S"D:\VIT\cp project" -B"D:\VIT\cp project\build-asan""
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Build dependencies for test verity_all_tests

build test_prep/verity_all_tests: phony verity_tests.exe


#############################################
# Build dependencies for all tests

build test_prep/all: phony test_prep/verity_all_tests

# =============================================================================
# Target aliases.

build verity_cli: phony verity.exe

build verity_core: phony verity_core.lib

build verity_tests: phony verity_tests.exe

# =============================================================================
