{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verity.graph/schema/extraction.schema.json",
  "title": "Verity Graph extraction record",
  "description": "Mirror of docs/CONTRACT.md section 7. Spans are half-open [start,end) ranges in UNICODE CODE POINTS of the normalized extracted text; quote must equal text[start:end].",
  "type": "object",
  "required": ["schema_version", "documents", "entities", "claims", "events", "citations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^(E|EV|C|D)0*[1-9][0-9]*$"
    },
    "span": {
      "type": "object",
      "required": ["start", "end", "quote"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string" }
      }
    },
    "date": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
        {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
            "to": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" }
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "required": ["id", "filename", "format", "normalized_text", "metadata", "citations"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "filename": { "type": "string", "minLength": 1 },
        "format": { "enum": ["txt", "pdf", "docx"] },
        "normalized_text": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeId" }
        }
      }
    },
    "mention": {
      "type": "object",
      "required": ["document_id", "span"],
      "additionalProperties": false,
      "properties": {
        "document_id": { "$ref": "#/$defs/nodeId" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "name", "type", "aliases", "mentions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["Person", "Organization", "Product", "Location"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "mentions": { "type": "array", "items": { "$ref": "#/$defs/mention" } }
      }
    },
    "claimObject": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["EntityRef", "StringValue", "DateValue", "QuantityValue"] }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "EntityRef" },
            "entity_id": { "$ref": "#/$defs/nodeId" }
          },
          "required": ["kind", "entity_id"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "StringValue" },
            "text": { "type": "string" }
          },
          "required": ["kind", "text"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "DateValue" },
            "date": { "$ref": "#/$defs/date" }
          },
          "required": ["kind", "date"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "QuantityValue" },
            "quantity": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "quantity", "unit"],
          "additionalProperties": false
        }
      ]
    },
    "claim": {
      "type": "object",
      "required": ["id", "subject_id", "predicate", "object", "polarity", "confidence", "document_id", "span", "valid_from", "valid_to"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "subject_id": { "$ref": "#/$defs/nodeId" },
        "predicate": { "enum": ["announced", "launched", "has_ceo", "located_at", "present_at", "happened_before", "cites"] },
        "object": { "$ref": "#/$defs/claimObject" },
        "polarity": { "enum": ["Positive", "Negative", "Unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "document_id": { "$ref": "#/$defs/nodeId" },
        "span": { "$ref": "#/$defs/span" },
        "valid_from": { "anyOf": [{ "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" }, { "type": "null" }] },
        "valid_to": { "anyOf": [{ "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" }, { "type": "null" }] }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "label", "entity_id", "date", "document_id", "span"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "label": { "type": "string", "minLength": 1 },
        "entity_id": { "$ref": "#/$defs/nodeId" },
        "date": { "$ref": "#/$defs/date" },
        "document_id": { "$ref": "#/$defs/nodeId" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["citing", "cited"],
      "additionalProperties": false,
      "properties": {
        "citing": { "$ref": "#/$defs/nodeId" },
        "cited": { "$ref": "#/$defs/nodeId" },
        "span": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }] }
      }
    }
  }
}
